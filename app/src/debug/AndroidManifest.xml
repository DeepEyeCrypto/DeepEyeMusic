<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only recovery test probe components -->
    <application>
        
        <!-- Debug recovery probe receiver (debug only) -->
        <receiver
            android:name=".debug.recovery.RecoveryProbeReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.deepeye.musicpro.action.SIMULATE_STREAM_EXPIRY" />
                <action android:name="com.deepeye.musicpro.debug.action.START_RECOVERY_PROBE" />
                <action android:name="com.deepeye.musicpro.debug.action.DUMP_RECOVERY_PROBE" />
                <action android:name="com.deepeye.musicpro.debug.action.TRIGGER_DUPLICATE_EXPIRY" />
                <action android:name="com.deepeye.musicpro.debug.action.TRIGGER_BUDGET_EXHAUSTION" />
            </intent-filter>
        </receiver>

        <!-- D7 FEmusic HTTP 400 status-only H1/H2 probe receiver (debug only).
             Logs HTTP status/duration only — never tokens, keys or bodies. -->
        <receiver
            android:name=".debug.d7.D7StatusProbeReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.deepeye.musicpro.debug.action.D7_STATUS_PROBE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
